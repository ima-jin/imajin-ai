# Variable NAMES only (imajin-ai#1932 quality bar: no secrets anywhere in
# code, fixtures, docs, or logs). Copy to `.env` (untracked) and fill in real
# values on the deploy host only.

# --- NanoClaw host / build ---
NANOCLAW_GIT_REF=
KERNEL_BASE_URL=
NANOCLAW_AGENT_DID=
NANOCLAW_OWNER_DID=
# Host path to the 0600 keypair file bootstrap-identity.ts wrote — never the
# key material itself.
NANOCLAW_AGENT_KEYPAIR_PATH_HOST=

# --- Brain path deviation (see docs/agents/nanoclaw-first-boot.md) ---
# Kernel completions passthrough (#1925) is OpenAI-compatible; NanoClaw's
# Claude Agent SDK speaks the Anthropic Messages API. Running on a scoped
# direct Anthropic key until the #1922 follow-up (Anthropic-format
# /infer/v1/messages passthrough) lands.
DIRECT_BRAIN_API_KEY=

# --- mcp-proxy sidecar ---
MCP_SERVER_URL=https://mcp.imajin.ai
MCP_PROXY_PORT=8788
MCP_PROXY_ATTESTATION_ID=

# --- usage-emitter sidecar ---
USAGE_EMIT_TOKEN=
