# Variable NAMES only (imajin-ai#1932 quality bar: no secrets anywhere in
# code, fixtures, docs, or logs). Copy to `.env` (untracked) and fill in real
# values on the deploy host only.

# --- NanoClaw host / build ---
NANOCLAW_GIT_REF=
KERNEL_BASE_URL=
NANOCLAW_AGENT_DID=
NANOCLAW_OWNER_DID=
# Host path to the 0600 keypair file bootstrap-identity.ts wrote — never the
# key material itself.
NANOCLAW_AGENT_KEYPAIR_PATH_HOST=
# GID of the host's docker group (`stat -c %g /var/run/docker.sock`) — lets
# the non-root container user reach the mounted Docker socket without
# running as root. Varies per host/distro.
DOCKER_GID=

# --- infer-passthrough sidecar (imajin-ai#1959/#1961 — the default brain path) ---
# Closes the earlier direct-Anthropic-key deviation: the NanoClaw container's
# ANTHROPIC_BASE_URL points at this shim's fixed /anthropic prefix, and this
# shim mints the kernel app-token on the NanoClaw agent DID's behalf instead.
INFER_PROXY_PORT=8787
# Raw hex Ed25519 private key (this shim's OWN pre-existing config contract,
# see docker-compose.yml's comment) — the SAME key as the keypair file at
# NANOCLAW_AGENT_KEYPAIR_PATH_HOST, extracted into this env var. Never logged.
NANOCLAW_AGENT_PRIVATE_KEY_HEX=

# --- Brain break-glass ONLY (see docs/agents/nanoclaw-first-boot.md) ---
# Feeds the infer-passthrough shim's "anthropic" route directApiKeyEnvVar
# (ANTHROPIC_DIRECT_API_KEY) — used automatically on a kernel 5xx/timeout,
# never on a kernel 4xx, and never sent to the NanoClaw container itself.
# Also doubles as the container's own ANTHROPIC_API_KEY value if brain.via
# is ever set to the 'direct' escape hatch (bypassing this shim entirely).
DIRECT_BRAIN_API_KEY=

# --- mcp-proxy sidecar ---
MCP_SERVER_URL=https://mcp.imajin.ai
MCP_PROXY_PORT=8788
MCP_PROXY_ATTESTATION_ID=

# --- usage-emitter sidecar ---
USAGE_EMIT_TOKEN=
