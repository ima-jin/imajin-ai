[Unit]
Description=One-time infer-passthrough gateway migration
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RuntimeDirectory=imajin-infer-passthrough-credential
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
LimitCORE=0
Environment=PATH=/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
LoadCredential=github-token:/etc/imajin/infer-passthrough-github-token
ExecStart=/usr/local/libexec/infer-passthrough/bootstrap.sh
TimeoutStartSec=30min
UMask=0077
