[Unit]
Description=Kernel-authorized inference gateway deployment credential delivery
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/flock --exclusive /run/imajin-infer-passthrough-credential/delivery.lock /usr/bin/node /usr/local/libexec/infer-passthrough/deployment-read.mjs
RuntimeDirectory=imajin-infer-passthrough-credential
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
UMask=0077
TimeoutStartSec=90s
LimitCORE=0
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/etc/imajin
ReadWritePaths=/run/imajin-infer-passthrough-credential
ProtectHome=true
PrivateTmp=true
