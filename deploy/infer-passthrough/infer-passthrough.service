[Unit]
Description=OpenClaw kernel inference passthrough
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=imajin
WorkingDirectory=/var/lib/imajin/infer-passthrough/current
EnvironmentFile=/etc/imajin/infer-passthrough.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/env node --import tsx packages/openclaw-infer-passthrough/src/server.ts
Restart=on-failure
RestartSec=5
TimeoutStopSec=10s
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
