{
  "name": "@imajin/vault-core",
  "version": "0.8.0",
  "private": true,
  "description": "Vault entry models, integrity verification, sealing and delegation primitives for Imajin nodes",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ima-jin/imajin-ai.git",
    "directory": "packages/vault-core"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
