    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@imajin/cid": "workspace:*",
    "@noble/curves": "^1.8.1",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.7.2"
  },
  "devDependencies": {
    "@types/node": "^24.9.2",
    "tsup": "^8.0.0",
    "typescript": "^5.9.3",
    "vitest": "^2.1.9"
  }
}
