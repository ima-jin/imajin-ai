{
  "name": "@imajin/media",
  "version": "0.8.16",
  "private": true,
  "description": "Media browser, asset display components, and resolveMediaRef/resolveAssetUrl helpers for Imajin apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ima-jin/imajin-ai.git",
    "directory": "packages/media"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5"
  }
}
