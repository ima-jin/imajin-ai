{
  "name": "@imajin/auth",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./broker-consent-vocabulary": {
      "types": "./dist/broker-consent-vocabulary.d.ts",
      "import": "./dist/broker-consent-vocabulary.js"
    },
    "./scope-vocabulary": {
      "types": "./dist/scope-vocabulary.d.ts",
      "import": "./dist/scope-vocabulary.js"
    },
    "./grant-scopes": {
      "types": "./dist/grant-scopes.d.ts",
      "import": "./dist/grant-scopes.js"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@imajin/config": "workspace:*",
    "@imajin/logger": "workspace:*",
    "@noble/curves": "^1.9.7",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.7.2"
  },
  "devDependencies": {
    "drizzle-orm": "^0.45.1",
    "typescript": "^5",
    "tsup": "^8.0.0",
    "@types/node": "^22.0.0"
  },
  "peerDependencies": {
    "next": ">=15.5.24"
  }
}
