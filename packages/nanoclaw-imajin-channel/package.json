{
  "name": "@imajin/nanoclaw-imajin-channel",
  "version": "0.1.0",
  "private": true,
  "description": "Imajin chat bridge for a NanoClaw instance (imajin-ai#1932): a NanoClaw ChannelAdapter reachable at its own agent DID via the existing jin.imajin.ai chat channel, plus the MCP token-refresh proxy and usage.incurred emitter sidecars it depends on.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "mcp-proxy": "tsx src/mcp-proxy/server.ts",
    "usage-emitter": "tsx src/usage-emitter/index.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@imajin/auth": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^2.1.9"
  }
}
