    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@imajin/db": "workspace:*",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5",
    "@types/node": "^22.0.0"
  }
}
