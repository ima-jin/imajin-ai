{
  "name": "@imajin/email",
  "version": "0.8.7",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@imajin/config": "workspace:*",
    "@imajin/logger": "workspace:*",
    "marked": "^18.0.4",
    "nodemailer": "^9.1.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.5",
    "typescript": "^5.3.0",
    "tsup": "^8.0.0",
    "@types/node": "^22.0.0"
  }
}
