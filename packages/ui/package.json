{
  "name": "@imajin/ui",
  "version": "0.8.0",
  "private": true,
  "description": "Shared UI components for Imajin apps — NavBar, identity management, app launcher, theming, and common patterns",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ima-jin/imajin-ai.git",
    "directory": "packages/ui"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js",
      "require": "./dist/server.cjs"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "dependencies": {
    "@imajin/config": "workspace:*",
    "@imajin/fair": "workspace:*",
    "@mdxeditor/editor": "^3.52.4",
    "react": "^18.2.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/react": "^18",
    "tsup": "^8.0.0",
    "typescript": "^5",
    "vitest": "^2.0.0",
    "@types/node": "^22.0.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  }
}
