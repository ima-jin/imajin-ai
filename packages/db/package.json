{
  "name": "@imajin/db",
  "version": "0.8.0",
  "private": true,
  "description": "Drizzle/postgres database handle shared across Imajin services",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ima-jin/imajin-ai.git",
    "directory": "packages/db"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.5"
  },
  "devDependencies": {
    "typescript": "^5",
    "@types/node": "^22.0.0",
    "tsup": "^8.0.0"
  }
}
