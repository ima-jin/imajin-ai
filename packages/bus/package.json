    "@imajin/fair": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5",
    "tsup": "^8.0.0",
    "@types/node": "^22.0.0"
  },
  "peerDependencies": {
    "next": ">=15.5.24"
  }
