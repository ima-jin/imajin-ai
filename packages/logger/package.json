{
  "name": "@imajin/logger",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./db": {
      "types": "./dist/db.d.ts",
      "import": "./dist/db.js"
    }
  },
  "files": [
    "dist/",
    "src/"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "nanoid": "^5",
    "pino": "^9"
  },
  "devDependencies": {
    "@imajin/db": "workspace:*",
    "typescript": "^5",
    "tsup": "^8.0.0",
    "@types/node": "^22.0.0"
  },
  "peerDependencies": {
    "next": ">=15.5.24",
    "@imajin/db": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@imajin/db": {
      "optional": true
    }
  }
}
