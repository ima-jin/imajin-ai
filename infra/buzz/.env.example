# Imajin Buzz relay — environment template (#1414)
# Copy to .env and fill in every CHANGE_ME value before running.
#
# Generate secrets quickly:
#   openssl rand -hex 32   # for 64-char hex secrets
#   openssl rand -hex 16   # for 32-char passwords

# ── Relay image ───────────────────────────────────────────────────────────────
# Pin to a SHA tag for production; :main tracks latest pre-release.
BUZZ_IMAGE=ghcr.io/block/buzz:main

# ── Relay identity (NEVER rotate after first use) ─────────────────────────────
# secp256k1 private key (hex, 32 bytes / 64 chars). The relay's signing identity.
# Events it signed become unverifiable if this changes.
BUZZ_RELAY_PRIVATE_KEY=CHANGE_ME_64_HEX

# ── Owner pubkey ─────────────────────────────────────────────────────────────
# 64-char lowercase hex Nostr pubkey of the relay operator (Ryan's key).
# ⚠️  Do NOT add a BUZZ_ prefix — the relay expects exactly RELAY_OWNER_PUBKEY.
# Convert from npub: npx @cmdcode/nip19 decode npub1...
RELAY_OWNER_PUBKEY=CHANGE_ME_64_HEX_OWNER_PUBKEY

# ── Git hook HMAC ─────────────────────────────────────────────────────────────
BUZZ_GIT_HOOK_HMAC_SECRET=CHANGE_ME_64_HEX

# ── Database (Postgres 17) ────────────────────────────────────────────────────
POSTGRES_DB=buzz
POSTGRES_USER=buzz
POSTGRES_PASSWORD=CHANGE_ME_PASSWORD

# ── Redis 7 ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_PASSWORD

# ── MinIO (S3-compatible media store) ─────────────────────────────────────────
BUZZ_S3_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
BUZZ_S3_SECRET_KEY=CHANGE_ME_SECRET_KEY
BUZZ_S3_BUCKET=buzz-media

# ── Network / URLs ───────────────────────────────────────────────────────────
# Update to your server's public IP or domain for a non-local deployment.
BUZZ_HTTP_PORT=3000
RELAY_URL=ws://localhost:3000
BUZZ_MEDIA_BASE_URL=http://localhost:3000/media
BUZZ_MEDIA_SERVER_DOMAIN=localhost
BUZZ_CORS_ORIGINS=http://localhost:3000

# ── Relay behaviour ───────────────────────────────────────────────────────────
BUZZ_REQUIRE_AUTH_TOKEN=true
BUZZ_REQUIRE_RELAY_MEMBERSHIP=true
BUZZ_ALLOW_NIP_OA_AUTH=true
BUZZ_AUTO_MIGRATE=true

# ── Logging ───────────────────────────────────────────────────────────────────
RUST_LOG=buzz_relay=info,buzz_db=info,buzz_auth=info,buzz_pubsub=info,tower_http=info
