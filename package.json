{
  "name": "imajin-ai",
  "version": "0.6.1",
  "private": true,
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "clean": "pnpm -r clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/reset-db.ts",
    "db:migrate": "node scripts/migrate.mjs",
    "sonar:baseline": "powershell -ExecutionPolicy Bypass -File scripts/sonar/phase1-capture-baseline.ps1",
    "sonar:legacy-review": "powershell -ExecutionPolicy Bypass -File scripts/sonar/phase15-legacy-debt-review.ps1",
    "sonar:batch": "node scripts/sonar/phase16-next-batch.mjs",
    "sonar:rip": "pnpm sonar:legacy-review && pnpm sonar:batch -- --lane A --size 10",
    "generate:api-specs": "tsx scripts/generate-api-specs.ts",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.0.0",
    "@eslint/js": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9",
    "eslint-config-imajin": "workspace:*",
    "eslint-config-next": "14",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-sonarjs": "^2.0.0",
    "globals": "^15.0.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "next": "^14.2.0",
    "postgres": "^3.4.5",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.9",
    "yaml": "^2.8.3"
  },
  "packageManager": "pnpm@9.15.0",
  "pnpm": {
    "overrides": {
      "@next/eslint-plugin-next": "^15.0.0",
      "brace-expansion@1": "^1.1.17",
      "brace-expansion@2": "^2.1.3",
      "brace-expansion@5": "^5.0.8",
      "js-yaml@3": "^3.15.0",
      "js-yaml@4": "^4.3.0",
      "minimatch@10": "^10.2.3",
      "postcss": "^8.5.18",
      "ws@7": "^7.5.11",
      "ws@8": "^8.21.0"
    }
  },
  "dependencies": {
    "@metalabel/dfos-protocol": "^0.13.5",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.7.2",
    "bs58": "^6.0.0",
    "sharp": "^0.35.0"
  }
}
