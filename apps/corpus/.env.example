# Corpus Service — per-DID corpus indexing and BM25 search (#1726)
#
# Not a web app — no Next.js, no browser-facing routes. Runs standalone via
# `npm start` (tsx src/index.ts). Internal-only: called over the LAN by the
# kernel (CORPUS_SERVICE_URL, apps/kernel/.env.example) and MCP tools. The
# localhost default kernel falls back to is only valid when kernel and corpus
# are colocated on the same host — point CORPUS_SERVICE_URL elsewhere if not.
#
# check-env annotations (scripts/check-env.ts, #2246): a comment line placed
# directly above a KEY=value line changes how check-env treats it:
#   # optional                 -> ok if unset in .env.local (warns once, grouped)
#   # vault-sourced: <reason>  -> fetched at boot; ok if unset, WARNS if hand-set
#   # deprecated: <reason>     -> WARNS if set; fine if unset
# No annotation = required (missing from .env.local is a hard error). See
# docs/ENVIRONMENTS.md.

# HTTP port. Defaults to 8003 if unset (src/index.ts). dev-jin and prod-jin
# (and every dev-*/prod-* pm2 pair) run side by side on the same host, so
# dev and prod corpus can't share a port: prod uses 8003 (this file's default,
# below, is the local-dev value), dev uses 8013. See
# deploy/ecosystem.{dev,prod}.config.js's dev-corpus/prod-corpus comments.
PORT=8013

# DEPRECATED (#2244) — CORPUS_KERNEL_PUBLIC_KEY is intentionally NOT a
# settable var in this template anymore. Corpus now fetches the kernel's
# Ed25519 *public* signing key set itself, from
# `{AUTH_SERVICE_URL}/.well-known/kernel-signing-key`, and pins it on first
# boot (trust-on-first-use) into data/corpus/kernel-trust.db.
#
# If your deployment still has CORPUS_KERNEL_PUBLIC_KEY set (e.g. an
# existing prod corpus from before #2244), it CONTINUES TO WORK AS-IS —
# corpus honors it verbatim as the sole trusted key and logs a loud
# deprecation warning on every boot while it remains set. To migrate:
# unset CORPUS_KERNEL_PUBLIC_KEY on the host; the very next boot performs
# the TOFU fetch-and-pin automatically, no other action required.
#
# TOFU semantics: on first boot with no pin yet, corpus fetches the kernel's
# published key set and persists it. Every later boot re-uses that pinned
# set; if the kernel now serves a key sharing no ID with the pin, corpus
# only WARNS (possible rotation or MITM) and never silently re-pins. If the
# kernel serves a NEW key alongside one already in the pin (a rotation
# grace window), the pin is extended automatically — no operator action
# needed. To force-accept a full break from the current pin, set
# CORPUS_KERNEL_PUBLIC_KEY_REPIN=1 for exactly one boot, then unset it
# again: if the served set already matches the pin the flag is a harmless
# no-op (logged), and after a real re-pin a loud warning reminds you to
# unset it before the next boot.
#
# Corpus must NEVER be given the kernel's private key — this is always a
# pinned/copied *public* key, never something corpus derives.
# optional
CORPUS_KERNEL_PUBLIC_KEY_REPIN=

# Corpus service identity (#1750/#1751, fetch-at-boot rework in #2243) —
# the *opposite* direction key pair from CORPUS_KERNEL_PUBLIC_KEY above:
# corpus's own Ed25519 DID + private key, used to sign IngestionAttestations
# at ingest time. The kernel must NEVER be given this private key,
# symmetrically to the rule above.
#
# DEPRECATED (#2243) as a directly-set pair — corpus now fetches this
# keypair from the vault at boot instead (CORPUS_VAULT_* below). Setting
# CORPUS_DID/CORPUS_DID_PRIVATE_KEY directly (e.g. via
# `npx tsx scripts/bootstrap-corpus-identity.ts`, an existing prod corpus
# from before #2243) CONTINUES TO WORK AS-IS — corpus honors it verbatim
# and logs a loud deprecation warning on every boot while it remains set.
# To migrate: unset these, set the CORPUS_VAULT_* trio below instead.
# vault-sourced: fetched at boot via loadFromVault (#2243) once CORPUS_VAULT_* is provisioned; do not set locally
CORPUS_DID=
# vault-sourced: fetched at boot via loadFromVault (#2243) once CORPUS_VAULT_* is provisioned; do not set locally
CORPUS_DID_PRIVATE_KEY=

# Vault fetch-at-boot (#2243): the replacement for CORPUS_DID/
# CORPUS_DID_PRIVATE_KEY above. Corpus fetches its real signing keypair —
# minted IN the vault (#2242), never hand-copied — through a one-time
# delegation grant (#2231), then acks the grant (#2235). All three of the
# following are required together; if any is missing corpus falls back to
# "no signing identity" (soft-fail, same as an all-unset CORPUS_DID today).
#
# CORPUS_VAULT_GRANT_ID is a POINTER, not a secret — an opaque, one-time-use
# grant id naming which vault-minted keypair to fetch. It is safe to see in
# a deploy log; it is useless to anyone without CORPUS_VAULT_BOOTSTRAP_*'s
# authority to redeem it, and it can only ever be redeemed once.
# transition (#2246): required together once the deprecated CORPUS_DID pair is retired; until then corpus soft-fails to it
# optional
CORPUS_VAULT_GRANT_ID=

# CORPUS_VAULT_BOOTSTRAP_DID / _PRIVATE_KEY are corpus's small, narrow-
# purpose bootstrap identity: an already-registered kernel identity whose
# ONLY job is authenticating the one-time fetch+ack above (never used to
# sign IngestionAttestations itself). This is the "honest bootstrap
# residue" epic #2241 calls out explicitly — not a zero-secret story, a
# reduction from N long-lived secrets to this one narrow-purpose one. See
# the #2243 PR description's "Deploy notes" for how to provision it, and
# its "Open questions" for the self-registering claim/pairing flow noted on
# #2241/#2243 that is expected to eventually replace this pair's manual
# provisioning step (tracked as follow-up, not implemented here).
# transition (#2246): required together once the deprecated CORPUS_DID pair is retired; until then corpus soft-fails to it
# optional
CORPUS_VAULT_BOOTSTRAP_DID=
# transition (#2246): required together once the deprecated CORPUS_DID pair is retired; until then corpus soft-fails to it
# optional
CORPUS_VAULT_BOOTSTRAP_PRIVATE_KEY=

# Kernel internal-attestation forwarding (#1750): corpus fire-and-forgets
# every signed IngestionAttestation to the kernel's durable auth.attestations
# via POST {AUTH_SERVICE_URL}/api/attestations/internal, mirroring
# packages/auth/src/emit-attestation.ts's two-phase pattern. AUTH_SERVICE_URL
# is the kernel's own base URL (apps/kernel/.env.example's AUTH_SERVICE_URL —
# same value, since corpus talks to the same kernel). If AUTH_SERVICE_URL is
# unset, or the kernel is unreachable, forwarding fails locally (recorded as
# forwarded_at=null, forward_error=<message>) and is retried, bounded, on
# the next ingest — it never blocks or fails the ingest itself.
AUTH_SERVICE_URL=

# DEPRECATED (#2245) — ATTESTATION_INTERNAL_API_KEY is intentionally NOT a
# settable var in this template anymore. It is a SHARED secret (the internal
# route only ever checks the kernel's own vault-generated value, not
# AUTH_INTERNAL_API_KEY) — corpus now fetches it from the vault at boot
# instead (see apps/corpus/src/lib/attestation-key.ts), reusing the SAME
# CORPUS_VAULT_BOOTSTRAP_DID/_PRIVATE_KEY identity above rather than a new
# one. Unlike CORPUS_VAULT_GRANT_ID, there is no fixed grant-id var to set
# here at all: the grant id is not known ahead of time and changes on
# rotation, so corpus discovers the CURRENT active grant for this purpose
# dynamically at every boot (loadFromVault's resolveGrantByPurpose, #2245).
# The kernel operator grants this secret to CORPUS_VAULT_BOOTSTRAP_DID once,
# via `npx tsx scripts/grant-attestation-internal-api-key.ts <thisCorpusDeployment'sBootstrapDid>`
# — a deliberate, human-run step every SHARED (cross-service) secret needs,
# unlike a single-consumer secret's fully automatic self-provisioning.
#
# If your deployment still has ATTESTATION_INTERNAL_API_KEY hand-set (e.g.
# an existing prod corpus from before #2245), it CONTINUES TO WORK AS-IS —
# corpus honors it verbatim and logs a loud deprecation warning on every
# boot while it remains set. To migrate: unset it and ensure the kernel
# operator has run the grant script above for this corpus's bootstrap DID.

# GitHub adapter token (optional — only read when ingesting a
# "github:owner/repo" source). Falls back to GH_TOKEN, then to the `gh` CLI's
# stored token (~/.config/gh/hosts.yml) if both are unset.
# DEPRECATED fallback only — the intended auth path is the source's own
# connector ref (#1528), not a node-wide token. Do not paste a long-lived
# personal access token here in production.
# optional
GITHUB_TOKEN=
# optional
GH_TOKEN=

# ─── Semantic layer (#1599, #1601) ──────────────────────────────────────────
# The PGX (bge-m3 embedder + bge-reranker-v2-m3 reranker) is a separate LAN
# host from corpus — corpus runs on imajin-server (prod :8003, dev :8013),
# the PGX does not share a box with it. Both URLs are required, LAN-local,
# and carry no secrets — there is deliberately NO localhost default here,
# since localhost would be wrong for corpus's actual host.
#
# Leaving either unset is a supported, first-class configuration: corpus
# boots and runs fine with no PGX configured at all — search silently stays
# BM25-only (`mode: "bm25"`) and no embedding pipeline runs. Set both to
# enable hybrid search.

# Base URL of the PGX embedder (bge-m3), OpenAI-compatible /v1/embeddings.
# e.g. http://pgx.lan:8001 — no trailing slash.
# optional
PGX_EMBED_URL=

# Base URL of the PGX reranker (bge-reranker-v2-m3).
# e.g. http://pgx.lan:8002 — no trailing slash. Optional even when
# PGX_EMBED_URL is set: hybrid search still runs without it, just without
# the final rerank pass (results are ordered by a combined BM25+vector score
# instead), and the response marks `degraded: ["rerank"]`.
# optional
PGX_RERANK_URL=

# Max texts per embed() call to the PGX. Keeps request bodies/timeouts
# bounded when ingesting large threads. Defaults to 64 if unset.
# optional
PGX_EMBED_BATCH_SIZE=

# Per-request timeout (ms) for both PGX_EMBED_URL and PGX_RERANK_URL calls.
# On timeout or any network/HTTP failure the corpus service fails CLOSED:
# search degrades to BM25-only (never a 500), and pending chunks stay
# pending for retry on the next ingest/sweep. Defaults to 5000 if unset.
# optional
PGX_TIMEOUT_MS=

NODE_ENV=
