# Corpus Service — per-DID corpus indexing and BM25 search (#1726)
#
# Not a web app — no Next.js, no browser-facing routes. Runs standalone via
# `npm start` (tsx src/index.ts). Internal-only: called over the LAN by the
# kernel (CORPUS_SERVICE_URL, apps/kernel/.env.example) and MCP tools.

# HTTP port. Defaults to 8003 if unset (src/index.ts). Same value in dev and
# prod — see deploy/ecosystem.{dev,prod}.config.js's prod-corpus comment for
# why corpus doesn't follow the 3xxx/7xxx convention.
PORT=8003

# GitHub adapter (optional — only read when ingesting a "github:owner/repo"
# source). Falls back to GH_TOKEN, then to the `gh` CLI's stored token
# (~/.config/gh/hosts.yml) if both are unset.
GITHUB_TOKEN=
GH_TOKEN=

NODE_ENV=
