# Market Service
#
# check-env annotations (scripts/check-env.ts, #2246): a comment line placed
# directly above a KEY=value line changes how check-env treats it:
#   # optional                 -> ok if unset in .env.local (warns once, grouped)
#   # vault-sourced: <reason>  -> fetched at boot; ok if unset, WARNS if hand-set
#   # deprecated: <reason>     -> WARNS if set; fine if unset
# No annotation = required (missing from .env.local is a hard error). See
# docs/ENVIRONMENTS.md.

# Database
DATABASE_URL=postgres://user:password@localhost:5432/imajin_dev

# Service URLs (internal)
AUTH_SERVICE_URL=http://localhost:3001
PAY_SERVICE_URL=http://localhost:3004
PROFILE_SERVICE_URL=http://localhost:3005
MEDIA_SERVICE_URL=http://localhost:3009
# Registry service (node self/DID lookup, #2000). Includes the /registry
# path prefix like every other *_SERVICE_URL (#2046) — do not omit it.
REGISTRY_SERVICE_URL=http://localhost:3000/registry

# Webhooks (unused — market routes through pay, but env check requires it)
WEBHOOK_SECRET=

# Public URLs (client-side)
NEXT_PUBLIC_BASE_URL=http://localhost:3104
NEXT_PUBLIC_PAY_URL=http://localhost:3004
NEXT_PUBLIC_DOMAIN=imajin.ai
# http://localhost: for local dev, https://dev- for deployed dev, https:// for prod
NEXT_PUBLIC_SERVICE_PREFIX=http://localhost:
NEXT_PUBLIC_MEDIA_URL=https://dev-media.imajin.ai

# Runtime
PORT=
NODE_ENV=
IMAJIN_ENV=dev

# Internal API key for kernel-internal service calls made via @imajin/auth
# (session act-as validation, X-Acting-For delegation resolution, app-token
# validation, and any local attestation-emission callers).
#
# ATTESTATION_INTERNAL_API_KEY is intentionally NOT a settable var in this
# template anymore (#2353, epic #2241): market fetches it from the vault at boot
# (`bootstrapInternalApiKey` in @imajin/auth, called from instrumentation.ts)
# using its own narrow-purpose bootstrap identity below — an already-registered
# kernel identity whose ONLY job is authenticating that one fetch. The kernel
# operator grants the shared secret to that DID once:
#   npx tsx scripts/grant-attestation-internal-api-key.ts <MARKET_VAULT_BOOTSTRAP_DID>
# If the key can't be resolved, market logs one ERROR naming the DID, purpose
# and that command, and internal posts to the kernel fail closed (they throw;
# they never send an empty Authorization header). The pair is REQUIRED (no
# check-env annotation): a deploy stops at check-env until it is provisioned.
# The boot ERROR above covers the other case — pair set, grant still missing.
#
# AUTH_INTERNAL_API_KEY is a separate, deprecated one-release fallback for
# attestation forwarding and also separately guards verify-delegation — unset
# means every such call 401s, so it carries NO check-env annotation and stays
# a hard error. Set it to match the kernel's value.
MARKET_VAULT_BOOTSTRAP_DID=
MARKET_VAULT_BOOTSTRAP_PRIVATE_KEY=
AUTH_INTERNAL_API_KEY=""

# .fair settlement — pay service credentials + node identity
PAY_SERVICE_API_KEY=
NODE_DID=
