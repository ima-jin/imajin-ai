# Market Service
#
# check-env annotations (scripts/check-env.ts, #2246): a comment line placed
# directly above a KEY=value line changes how check-env treats it:
#   # optional                 -> ok if unset in .env.local (warns once, grouped)
#   # vault-sourced: <reason>  -> fetched at boot; ok if unset, WARNS if hand-set
#   # deprecated: <reason>     -> WARNS if set; fine if unset
# No annotation = required (missing from .env.local is a hard error). See
# docs/ENVIRONMENTS.md.

# Database
DATABASE_URL=postgres://user:password@localhost:5432/imajin_dev

# Service URLs (internal)
AUTH_SERVICE_URL=http://localhost:3001
PAY_SERVICE_URL=http://localhost:3004
PROFILE_SERVICE_URL=http://localhost:3005
MEDIA_SERVICE_URL=http://localhost:3009
# Registry service (node self/DID lookup, #2000). Includes the /registry
# path prefix like every other *_SERVICE_URL (#2046) — do not omit it.
REGISTRY_SERVICE_URL=http://localhost:3000/registry

# Webhooks (unused — market routes through pay, but env check requires it)
WEBHOOK_SECRET=

# Public URLs (client-side)
NEXT_PUBLIC_BASE_URL=http://localhost:3104
NEXT_PUBLIC_PAY_URL=http://localhost:3004
NEXT_PUBLIC_DOMAIN=imajin.ai
# http://localhost: for local dev, https://dev- for deployed dev, https:// for prod
NEXT_PUBLIC_SERVICE_PREFIX=http://localhost:
NEXT_PUBLIC_MEDIA_URL=https://dev-media.imajin.ai

# Runtime
PORT=
NODE_ENV=
IMAJIN_ENV=dev

# ATTESTATION_INTERNAL_API_KEY is no longer settable here (#2353): @imajin/auth
# callers (session act-as validation, attestation emission) use the value this
# service fetches from the vault at boot (instrumentation.ts), authenticating
# with the bootstrap identity below. Deploy provisions the pair and its grant
# (scripts/provision-service-bootstrap.mjs, #2442) after the production gate;
# locally, scripts/setup-local.sh does. Never hand-mint it.
# Required (no check-env annotation): check-env still fails if the pair is
# absent, but deploy provisions it before check-env runs.
MARKET_VAULT_BOOTSTRAP_DID=
MARKET_VAULT_BOOTSTRAP_PRIVATE_KEY=
# AUTH_INTERNAL_API_KEY is a deprecated one-release fallback for attestation
# forwarding (#2037) and also separately guards verify-delegation — unset means
# every such call 401s, so it carries NO check-env annotation. Set it to match
# the kernel's value.
AUTH_INTERNAL_API_KEY=""

# .fair settlement — node identity.
NODE_DID=

# Registered-app settlement (#2740). Market settles through pay's registered-app
# contract: it mints its OWN app-service token (never a shared pay key) using the
# signing key it fetches via loadAppSigningKey. Operator prerequisites: register
# market as an app (apps.provision), approve `pay:settle` on the
# `apps:service-scopes` card, then set the IMAJIN_* values below. Until then,
# purchases of listings with a .fair chain fail closed (503) rather than taking
# money that could never settle.
# Kernel base URL (no /auth suffix), e.g. https://jin.imajin.ai.
# optional
IMAJIN_KERNEL_URL=http://localhost:3000
# Market's own app DID, as minted by apps.provision. Required once the keystore exists.
# optional
IMAJIN_APP_DID=
# One-time claim code from the /jin operator-approval reveal. First boot only.
# optional
IMAJIN_APP_CLAIM_CODE=
# Where the bootstrap keypair is persisted (default ./.imajin/keystore.json).
# optional
IMAJIN_APP_KEYSTORE=
