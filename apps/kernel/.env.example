# =============================================================================
# Kernel — consolidated env for all kernel services
# (www, auth, pay, profile, registry, connections, chat, media, notify)
# =============================================================================
#
# check-env annotations (scripts/check-env.ts, #2246): a comment line placed
# directly above a KEY=value line changes how check-env treats it:
#   # optional                 -> ok if unset in .env.local (warns once, grouped)
#   # vault-sourced: <reason>  -> fetched at boot; ok if unset, WARNS if hand-set
#   # deprecated: <reason>     -> WARNS if set; fine if unset
# No annotation = required (missing from .env.local is a hard error). See
# docs/ENVIRONMENTS.md.

NODE_ENV=production
IMAJIN_ENV=dev
PORT=3000

# --- Database ---
DATABASE_URL="postgresql://user:password@localhost:5432/imajin_dev"

# --- Vault (#2357) ---
# Absolute path to this kernel's on-disk sealed-secrets vault file
# (FileVaultRepository — owner GitHub OAuth tokens, connector config, Warp
# API keys, etc). MUST be distinct per environment: dev and prod must never
# read/write the same vault file, or dev code can read and re-seal
# prod-sealed material. deploy/ecosystem.{dev,prod}.config.js set this to
# ~/.imajin/vault.{dev,prod}.json respectively (a literal leading `~` is
# expanded to the process's home directory — see
# apps/kernel/src/lib/vault/vault-path.ts). Required in production: the
# kernel refuses to start rather than silently fall back to the shared
# ~/.imajin/vault.json default. See docs/ENVIRONMENTS.md.
VAULT_PATH=""

# --- Auth ---
AUTH_PRIVATE_KEY=""
# Rotation grace window (#2244) for GET /auth/.well-known/kernel-signing-key:
# optional, and only meaningful together. Set AUTH_PREVIOUS_PUBLIC_KEY to the
# public half of the key you just rotated AUTH_PRIVATE_KEY away from, and
# AUTH_PREVIOUS_PUBLIC_KEY_VALID_UNTIL to when it should stop being served
# (ISO 8601) — both are required together, so a previous key can never be
# published with an indefinite (by-omission) grace window. Once VALID_UNTIL
# passes, the previous key drops out of the response automatically.
# AUTH_PREVIOUS_PUBLIC_KEY_VALID_FROM is optional metadata only (defaults to
# the unix epoch — this codebase doesn't track true key-mint timestamps).
# optional
AUTH_PREVIOUS_PUBLIC_KEY=""
# optional
AUTH_PREVIOUS_PUBLIC_KEY_VALID_FROM=""
# optional
AUTH_PREVIOUS_PUBLIC_KEY_VALID_UNTIL=""
# DEPRECATED (#2245) — ATTESTATION_INTERNAL_API_KEY is intentionally NOT a
# settable var in this template anymore. The kernel now self-provisions this
# shared internal secret as a vault-generated grant on first use (purpose
# 'kernel.attestation-internal-api-key', see
# apps/kernel/src/lib/vault/internal-secret.ts) and self-grants it to its
# own node DID for the Bearer-authenticated internal routes
# (attestations/internal, attestations/chain-emit, apps/validate,
# groups/.../controllers, credentials/resolve, identity/:did/contact) to
# check — no operator action, no env var, for that side.
#
# The kernel ALSO grants the exact same secret to corpus (the one external
# consumer, which forwards ingestion attestations here — see
# apps/corpus/src/lib/attestation-key.ts) via a deliberate, operator-run
# step: `npx tsx scripts/grant-attestation-internal-api-key.ts <corpusBootstrapDid>`.
# See apps/kernel/src/lib/vault/shared-internal-secret.ts for why granting a
# SECOND party (unlike self-provisioning) is never automatic.
#
# If your deployment still has ATTESTATION_INTERNAL_API_KEY hand-set on the
# host (e.g. an existing prod kernel from before #2245, or a
# not-yet-migrated caller such as packages/auth/src/internal-post.ts's
# other users), it CONTINUES TO WORK AS-IS as a deprecated fallback — every
# internal route accepts it in addition to the vault-sourced value, logging
# a loud deprecation warning the first time a caller authenticates with it.
# Do not re-add a template line for it; unset it on any host that still has
# it once every caller has moved onto the vault path.
# Separate internal API key checked by the x-internal-key-authenticated
# routes (auth/api/internal/verify-delegation, auth/api/internal/grants/introspect)
# — required for those; unset here means every such call 401s (the #1520
# class of silent-until-runtime failure check-env exists to catch), so this
# key deliberately carries NO check-env annotation and stays a hard error.
# Also accepted as a deprecated one-release fallback for
# ATTESTATION_INTERNAL_API_KEY in emit-attestation.ts (#2037) — do not rely
# on that fallback for new code; set that var directly instead. Runtime
# already warns on that fallback path (packages/auth/src/internal-post.ts).
# NOTE: #2245 made ATTESTATION_INTERNAL_API_KEY itself vault-sourced (see
# above) — this var's OWN x-internal-key-authenticated usage stays a
# hand-set secret; generalizing it too is explicitly out of #2245's scope.
AUTH_INTERNAL_API_KEY=""
GROUP_KEY_ENCRYPTION_SECRET=""
ADMIN_DID=did:imajin:your-admin-did
# Server-held pepper for the claimable-stub email match key (#1834). Used to
# derive both the salted/peppered HMAC-SHA256 dedup key (auth.claim_stub_index)
# and the AES-256-GCM key that encrypts the stub's email at rest. Never used
# for anything else — rotating it orphans any not-yet-claimed stub's dedup
# entry (existing identities/credentials are unaffected).
CLAIMABLE_STUB_EMAIL_SECRET=""
# FOREIGN_PRINCIPAL_STUB_SECRET was the hand-set pepper for the
# foreign-principal-stub dedup key (#2251, auth.foreign_principal_stubs).
# Removed entirely (#2245, per the epic-#2241 ruling 2026-09-22): the kernel
# now self-provisions this pepper as a vault-generated internal secret on
# first use (purpose 'kernel.foreign-principal-pepper') and self-grants it
# to its own node DID — no operator action, no env var, ever. See
# apps/kernel/src/lib/vault/internal-secret.ts. Do not re-add this var.

# --- Stripe (Pay) ---
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_CONNECT_WEBHOOK_SECRET=""
EVENTS_WEBHOOK_SECRET=""
COFFEE_WEBHOOK_SECRET=""
PAY_SERVICE_API_KEY=""
SOLANA_RPC_URL="https://api.mainnet-beta.solana.com"
# Also doubles as the shared identity for connectors that use a two-tier
# credential model (#1775, e.g. QuickBooks): an administrator seals the
# provider's OAuth app config to this DID once, and every other user's
# "Connect" click rides on it instead of needing their own app registration.
PLATFORM_DID=did:imajin:platform
PLATFORM_FEE_PERCENT=0.2

# --- Email ---
# Provider: sendgrid | postal | smtp (default: sendgrid)
EMAIL_PROVIDER=sendgrid

# SendGrid
SENDGRID_API_KEY=""
SENDGRID_FROM="Name <email@example.com>"
SENDGRID_FROM_EMAIL=notifications@example.com

# Postal
POSTAL_API_URL=""
POSTAL_API_KEY=""
POSTAL_FROM=""

# SMTP
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# --- Media ---
MEDIA_ROOT=/mnt/media
MEDIA_INTERNAL_API_KEY=""
GPU_NODE_URL=http://localhost:8765
GPU_AUTH_TOKEN=

# --- Profile ---
# Internal API key checked by the Bearer-authenticated "service scope" path
# of POST /profile/api/resolve (#1998) — grants email disclosure for every
# requested DID, matching the trust level packages/auth/src/credentials.ts
# and events' guest/sales export routes already had via direct DB reads.
PROFILE_INTERNAL_API_KEY=""

# --- MCP (Claude Desktop connector, #1166) ---
# Public origin of the MCP server (Caddy vhost -> kernel). Used as the OAuth
# issuer, the protected-resource `aud`, and the /mcp endpoint URL.
MCP_PUBLIC_URL=https://mcp.imajin.ai

# --- Warp Cloud Agents (per-DID dispatch, #1428) ---
# Nothing about *who* dispatches or *where* it lands is an env var. The Warp Agent
# key is sealed per-DID as a v2 delegation-grant vault field via POST
# /warp/api/seal, and the default cloud environment is a per-DID vault field set
# from the Warp connector card (PUT /warp/api/environment, #1632). The node-wide
# environment default is just the field stored against the node's own DID — one
# DID-scoped mechanism instead of a process-scoped second one. This is the only
# Warp env var: it points dispatch at the platform, which is not per-DID config.
WARP_API_BASE_URL=https://app.warp.dev/api/v1

# --- AI/Inference (#1621 — bring your own brain) ---
# There is NO kernel-wide model API key. Inference credentials are sealed
# per-DID through connector cards (/gemini/api/token, /anthropic/api/token) and
# resolved at call time from the acting identity's sealed connections. A shared
# env key would mean every user's inference ran on one node credential, which is
# what this design removes — so ANTHROPIC_API_KEY / OPENAI_API_KEY are no longer
# read. A DID with no sealed brain fails closed with an actionable error.
# Ollama is the exception: a local endpoint, no key.
OLLAMA_BASE_URL=http://localhost:11434

# --- Local inference connector egress guard (#1957) ---
# The `local` connector (BRAIN_CONNECTORS 'local') fetches an OWNER-supplied
# baseUrl (Ollama/vLLM). On a hosted, multi-tenant kernel, any DID that can
# grant itself local:infer and save a baseUrl would otherwise get a read-SSRF
# primitive into the platform's own private LAN via GET /local/api/models (and
# every completions call) — so RFC1918/fc00::/7 private addresses are DENIED
# by default (loopback/link-local/metadata/multicast/reserved are ALWAYS
# denied, allowlist or not). Set this to reach specific private
# hosts/ranges: a comma-separated list of host[:port] literals and/or CIDR
# blocks (e.g. "10.0.0.5:8000,192.168.1.0/24"), or "*" to allow every private
# address — the right setting for a self-hosted, single-tenant kernel where
# the kernel's own LAN and the owner's LAN are the same trust domain. Leave
# unset on a hosted/shared kernel.
LOCAL_INFER_PRIVATE_ALLOWLIST=""

# --- Notify ---
NOTIFY_WEBHOOK_SECRET=""
UNSUBSCRIBE_HMAC_SECRET=""
# Web push (VAPID) for the /jin phone push path (#2291). The VAPID keypair
# itself is NEVER an env var — the kernel self-provisions and self-grants it
# on first use via getOrGenerateInternalSecret (#2245 pattern; see
# apps/kernel/src/lib/notify/vapid.ts). This is the one PLAIN (non-secret)
# var the web-push leg reads: the mailto/URL contact RFC 8292 requires every
# VAPID JWT to carry. Falls back to APP_URL, then a generic mailto, if unset.
# optional
VAPID_SUBJECT=""

# --- Registry / Relay ---
RELAY_STORE=postgres
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_BASE_DOMAIN="imajin.ai"
TRUST_INTERNAL_API_KEY=""

# --- Internal service URLs (kernel self-references) ---
AUTH_SERVICE_URL=http://localhost:3000/auth
AUTH_INTERNAL_URL=http://localhost:3000/auth
CONNECTIONS_SERVICE_URL=http://localhost:3000/connections
CONNECTIONS_URL=http://localhost:3000/connections
PROFILE_SERVICE_URL=http://localhost:3000/profile
PAY_SERVICE_URL=http://localhost:3000/pay
CHAT_SERVICE_URL=http://localhost:3000/chat
MEDIA_SERVICE_URL=http://localhost:3000/media
NOTIFY_SERVICE_URL=http://localhost:3000/notify
REGISTRY_SERVICE_URL=http://localhost:3000/registry
# corpus is an internal daemon on its own fixed port, not the kernel's 3xxx
# consolidated port (deploy/ecosystem.{dev,prod}.config.js). 8013 is the dev
# port; prod is 8003 (corpus-client.ts's fallback default). This value is
# only correct when kernel and corpus are colocated on the same host — point
# it at the right host otherwise.
CORPUS_SERVICE_URL=http://localhost:8013

# --- Userspace service URLs ---
EVENTS_SERVICE_URL=http://localhost:3006
EVENTS_URL=https://your-node.imajin.ai/events
COFFEE_SERVICE_URL=http://localhost:3100
LINKS_SERVICE_URL=http://localhost:3102
DYKIL_SERVICE_URL=http://localhost:3101
LEARN_SERVICE_URL=http://localhost:3103

# --- Public origin (SERVER-side, runtime — #1608) ---
# The node's public origin, used to anchor browser-facing redirects (e.g. the
# 401 -> /auth/login redirect for share links). Deliberately NOT a NEXT_PUBLIC_*
# var: those are inlined at build time, while this is read per-request, so a
# rebuild is never required to correct it. Behind Caddy, request.url reports
# Next's internal origin (localhost:3000), which is unreachable from a browser.
# Origin only — no path, no trailing slash.
APP_URL=https://your-node.imajin.ai

# --- Public URLs (client-side, update for your node domain) ---
NEXT_PUBLIC_SERVICE_PREFIX=https://your-node.imajin.ai/
NEXT_PUBLIC_DOMAIN=imajin.ai
NEXT_PUBLIC_DISABLE_INVITE_GATE=true
NEXT_PUBLIC_AUTH_URL=https://your-node.imajin.ai/auth
NEXT_PUBLIC_WWW_URL=https://your-node.imajin.ai
NEXT_PUBLIC_CHAT_URL=https://your-node.imajin.ai/chat
NEXT_PUBLIC_CONNECTIONS_URL=https://your-node.imajin.ai/connections
NEXT_PUBLIC_EVENTS_URL=https://your-node.imajin.ai/events
NEXT_PUBLIC_PAY_URL=https://your-node.imajin.ai/pay
NEXT_PUBLIC_PROFILE_URL=https://your-node.imajin.ai/profile
NEXT_PUBLIC_REGISTRY_URL=https://your-node.imajin.ai/registry
NEXT_PUBLIC_COFFEE_URL=https://your-node.imajin.ai/coffee
NEXT_PUBLIC_DYKIL_URL=https://your-node.imajin.ai/dykil
NEXT_PUBLIC_LINKS_URL=https://your-node.imajin.ai/links
NEXT_PUBLIC_LEARN_URL=https://your-node.imajin.ai/learn
NEXT_PUBLIC_MARKET_URL=https://your-node.imajin.ai/market
NEXT_PUBLIC_MEDIA_SERVICE_URL=https://your-node.imajin.ai/media
NEXT_PUBLIC_MEDIA_URL=https://your-node.imajin.ai/media
NEXT_PUBLIC_NOTIFY_URL=https://your-node.imajin.ai/notify
NEXT_PUBLIC_BASE_URL=https://your-node.imajin.ai
NEXT_PUBLIC_APP_URL=https://your-node.imajin.ai/chat
# Node identity DID (from auth.identities — required for admin console)
NODE_DID=""
