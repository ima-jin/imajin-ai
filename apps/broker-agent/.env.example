# check-env annotations (scripts/check-env.ts, #2246): a comment line placed
# directly above a KEY=value line changes how check-env treats it:
#   # optional                 -> ok if unset in .env.local (warns once, grouped)
#   # vault-sourced: <reason>  -> fetched at boot; ok if unset, WARNS if hand-set
#   # deprecated: <reason>     -> WARNS if set; fine if unset
# No annotation = required (missing from .env.local is a hard error). See
# docs/ENVIRONMENTS.md.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Anthropic API key for LLM routing
ANTHROPIC_API_KEY=

# Kernel API base URL (no trailing slash)
KERNEL_URL=https://jin.imajin.ai

# Bot's registered Imajin app DID and Ed25519 private key (raw 32-byte hex seed)
# The agent self-mints a short-lived service token at startup using the keypair.
# Register the app via POST /auth/api/apps and use the returned DID + private key.
APP_DID=
APP_PRIVATE_KEY=

# Optional: how often to poll for pending match notifications (ms, default 30000)
# optional
MATCH_POLL_INTERVAL_MS=30000
