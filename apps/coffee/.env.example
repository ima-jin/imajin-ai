# Coffee Service

# Database
DATABASE_URL=postgres://user:password@localhost:5432/imajin_dev

# Service URLs (internal)
AUTH_SERVICE_URL=http://localhost:3001
PAY_SERVICE_URL=http://localhost:3004
PROFILE_SERVICE_URL=http://localhost:3005
# Registry service (node self/DID lookup, #2000). Includes the /registry
# path prefix like every other *_SERVICE_URL (#2046) — do not omit it.
REGISTRY_SERVICE_URL=http://localhost:3000/registry

# Webhooks
WEBHOOK_SECRET=your-webhook-secret

# Public URLs (client-side)
NEXT_PUBLIC_BASE_URL=http://localhost:3100
NEXT_PUBLIC_DOMAIN=imajin.ai
# http://localhost: for local dev, https://dev- for deployed dev, https:// for prod
NEXT_PUBLIC_SERVICE_PREFIX=http://localhost:

# Notify
NOTIFY_SERVICE_URL=http://localhost:3008
NOTIFY_WEBHOOK_SECRET=dev-secret-change-me

# Runtime
PORT=
NODE_ENV=

# Internal API key(s) for kernel-internal service calls made via @imajin/auth
# (session act-as validation, X-Acting-For delegation resolution, and any
# local attestation-emission callers). ATTESTATION_INTERNAL_API_KEY is
# canonical for attestation forwarding (#2037) — AUTH_INTERNAL_API_KEY is a
# deprecated one-release fallback for it, and also separately guards
# verify-delegation. Set both to match the kernel's values.
ATTESTATION_INTERNAL_API_KEY=""
AUTH_INTERNAL_API_KEY=""
