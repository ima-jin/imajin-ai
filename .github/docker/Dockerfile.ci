FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive

# Core tools + Node 22.
#
# Node.js is installed from NodeSource's official APT repository instead of
# piping their setup script into `bash` (curl | bash executes an unverified,
# unpinned script with root privileges — SonarCloud docker:S8482). The GPG
# key fetched below is used by apt to verify the signature of every package
# it installs from that repository (docker:S8482), the download itself is
# forced over HTTPS/TLS (docker:S6506), and the repository is pinned to the
# node_22.x release line so the Node major version can't silently drift.
# CI utilities (sudo, jq, unzip) are installed alongside the Node toolchain
# deps in the same RUN as the Node setup below (docker:S7031 — consecutive RUN
# instructions should be merged to avoid extra image layers).
RUN apt-get update && apt-get install -y --no-install-recommends \
  ca-certificates \
  curl \
  git \
  gnupg \
  jq \
  sudo \
  unzip \
  && mkdir -p /etc/apt/keyrings \
  && curl -fsSL --proto '=https' --tlsv1.2 https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
  && chmod 644 /etc/apt/keyrings/nodesource.gpg \
  && echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_22.x nodistro main" > /etc/apt/sources.list.d/nodesource.list \
  && apt-get update && apt-get install -y --no-install-recommends nodejs \
  && npm install -g --ignore-scripts pnpm@9.15.0 \
  && apt-get clean && rm -rf /var/lib/apt/lists/*

# docker:S6471 (running as root): switch the image's default user away from
# root. `ci.yml` and the deploy/publish workflows that reference this image
# use it as a GitHub Actions `container:` (not a Docker container *action*),
# so the default user only affects `docker exec` steps, not artifact-upload
# machinery. USER_UID/USER_GID are build args (rather than a hardcoded id) so
# whoever re-pins the digest in those workflows (see ci.yml's comment on this
# file) can rebuild with `--build-arg USER_UID=$(id -u)` matching the actual
# imajin-self-hosted runner account if the default below doesn't line up,
# without editing this file. NOPASSWD sudo keeps any step that still needs
# root (e.g. an ad-hoc apt-get) working without reintroducing root-by-default.
ARG USER_NAME=ci
ARG USER_UID=1000
ARG USER_GID=1000
RUN groupadd --gid "${USER_GID}" "${USER_NAME}" \
  && useradd --create-home --shell /bin/bash --uid "${USER_UID}" --gid "${USER_GID}" "${USER_NAME}" \
  && echo "${USER_NAME} ALL=(ALL) NOPASSWD:ALL" > "/etc/sudoers.d/${USER_NAME}" \
  && chmod 440 "/etc/sudoers.d/${USER_NAME}"

USER ${USER_NAME}

CMD ["bash"]
